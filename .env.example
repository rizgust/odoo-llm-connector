# Odoo 16 connection — use a dedicated user, see README "Odoo service user"
ODOO_URL=https://odoo.example.com
ODOO_DB=production
ODOO_USER=chatgpt-reports@example.com
ODOO_API_KEY=

# Secret part of the connector URL: https://<MCP_PUBLIC_HOST>/mcp/<MCP_ACCESS_TOKEN>
# Generate with: openssl rand -hex 32   (letters, digits, '-' and '_' only; min 32 chars)
MCP_ACCESS_TOKEN=
# Public hostname ChatGPT connects to (only this Host header is accepted). Leave empty to disable.
MCP_PUBLIC_HOST=odoo-mcp.example.com
MCP_LISTEN_ADDR=:8000

# Optional: restrict to these models (comma-separated glob patterns). Empty = all except blocked.
# ODOO_ALLOWED_MODELS=sale.*,account.invoice.report,account.move*,purchase.*,stock.*,crm.*,product.*,res.partner
# Optional: replace the default blocklist (ir.*, base.*, res.users.apikeys*, res.partner.bank, ...)
# ODOO_BLOCKED_MODELS=ir.*,base.*,res.users.apikeys*
# ODOO_DEFAULT_LIMIT=80
# ODOO_MAX_LIMIT=500
# ODOO_MAX_TEXT_LENGTH=500
# ODOO_TIMEOUT_SECONDS=60
